# SupplyHub — ejemplo de configuración local.
# Copia a .env. NUNCA subas .env al repositorio.

# Django
DJANGO_SECRET_KEY=change-me-local-only
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_ADMIN_URL=admin/
DJANGO_LOG_LEVEL=INFO

# Seguridad HTTP (activar en producción cuando HTTPS esté listo)
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# Cifrado de configuración: variables sensibles pueden almacenarse como fernet:<token>
# La llave NO se versiona. Generar con:
#   python Otros/manage.py generate_encryption_key
APP_CONFIG_ENCRYPTION_KEY=

# Cifrado de datos persistentes sensibles (tokens OAuth futuros, etc.)
APP_ENCRYPTION_ENABLED=False
APP_ENCRYPTION_KEY=

# DataAnalytics — autorización corporativa. Desactivado durante el bootstrap.
DATAANALYTICS_ENABLED=False
DATAANALYTICS_DB_SERVER=
DATAANALYTICS_DB_PORT=
DATAANALYTICS_DB_NAME=DataAnalytics
DATAANALYTICS_DB_USER=
DATAANALYTICS_DB_PASSWORD=
DATAANALYTICS_DB_DRIVER=ODBC Driver 18 for SQL Server
DATAANALYTICS_SP_VALIDATE=dbo.GetValidaUsuarioDAsp
DATAANALYTICS_SP_ADD_ACCESS=dbo.AddUsuarioAccesoDAsp

# Proveedores de autenticación corporativa — Fase 2
GOOGLE_OAUTH_ENABLED=False
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=

AD_LDAP_ENABLED=False
AD_LDAP_SERVER_URI=
AD_LDAP_DOMAIN=
AD_LDAP_USER_SEARCH_BASE_DN=
AD_LDAP_USER_SEARCH_FILTER=(sAMAccountName={username})
AD_LDAP_USE_SSL=True
AD_LDAP_START_TLS=False
AD_LDAP_TLS_VALIDATE=none

PAYROLL_AUTH_ENABLED=False
